# Salin jadi .env lalu isi. JANGAN commit file .env ke GitHub.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=isi_dengan_anon_public_key
# Backend ini SENGAJA tidak memakai service_role key (supaya RLS kepakai).

# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=ganti_dengan_string_acak_panjang

# 1 = cookie hanya dikirim lewat HTTPS (wajib di production). Pakai 0 kalau tes lewat http di LAN.
SESSION_COOKIE_SECURE=1
SESSION_LIFETIME_HOURS=12
KAS_KECIL_MINIMUM=100000

# --- QRIS otomatis (lihat docs/qris_webhook.md). Isi dari skrip db/buat_akun_sistem_qris.py ---
QRIS_WEBHOOK_SECRET=
QRIS_SYSTEM_EMAIL=
QRIS_SYSTEM_PASSWORD=
# 1 = aktifkan halaman simulator /qris-demo dan pintu demo. WAJIB 0 atau dihapus saat go-live.
QRIS_SIMULATOR=0
